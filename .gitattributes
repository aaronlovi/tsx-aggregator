# Normalize text files to LF in the repository; working-copy line endings
# follow the platform (LF on Linux/WSL, CRLF on Windows with core.autocrlf=true).
* text=auto

# Shell scripts must keep LF everywhere (they run inside Linux/containers)
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.ico binary
*.gif binary
*.pdf binary
