# Copy to local.env (git-ignored) next to docker-compose.yml and fill in. Used with:
#   docker compose --env-file .env --env-file local.env --profile app up -d --build tsx-web
# Values here override .env.

# Google service-account key for the quote sheet (absolute path on this machine, readable by you only).
GOOGLE_CREDENTIALS_FILE=/home/you/tsx-secrets/google.json

# Gmail alerts: an app password (Google account > Security > App passwords), not the account password.
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=
ALERT_SENDER_EMAIL=you@gmail.com
# One address, or several separated by commas.
ALERT_RECIPIENT=you@gmail.com

# Deploy laptop: the site on the home wifi (port 5080, Windows firewall allows the local network only),
# PostgreSQL on this machine only.
WEB_BIND=0.0.0.0
POSTGRES_BIND=127.0.0.1

# Dev laptop testing: turn off what must only run once (Deploy Laptop Plan 2.7) and use other ports/database.
# RUN_RAW_COLLECTOR=false
# RUN_QUOTE_SERVICE=false
# RUN_TOP_SCORE_ALERT_SERVICE=false
# AGGREGATOR_GRPC_PORT=7097
# WEB_PORT=5097
# TSX_DATABASE=tsx_test

# Read-only web API (405 for anything but GET/HEAD/OPTIONS). Default true.
# API_READ_ONLY=true
